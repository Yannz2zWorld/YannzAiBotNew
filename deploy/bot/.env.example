# YannAjah AI (bot) — salin ke .env lalu isi. JANGAN bagikan file .env asli.
# Tautan web database SUDAH tertanam di yannajah.js (tidak perlu diisi di sini).

# Owner bot (nomor internasional tanpa +).
OWNER_NUMBER=6281234567890
OWNER_NAME=Owner

# API key APIZ2Z (buat di https://apiz2z.web.id -> menu API key).
APIZ2Z_API_KEY=

# Metode pairing saat belum ada session: ask | qr | pairing
PAIRING_METHOD=ask
# Custom pairing code tepat 8 karakter huruf besar/angka. Kosong = YANNAJAH.
PAIRING_CUSTOM_CODE=
# Nama instance bot ini (unik per proses bot).
BOT_INSTANCE_NAME=yannajah-main

# Login PERTAMA tanpa console (opsional). Di panel Pterodactyl tidak perlu: ketik di console.
# Setelah login berhasil, hapus dua baris ini.
# BOT_AUTH_PHONE=
# BOT_AUTH_PASSWORD=

# Opsional
# BOT_PREFIX=.,!,#,/
# LOG_LEVEL=info
# LIMIT_HARIAN=10
# FFMPEG_PATH=ffmpeg
# MEDIA_MAX_CONCURRENT=1
# FFMPEG_THREADS=1
